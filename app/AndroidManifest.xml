<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cathelperawa.owo.app"
    android:versionCode="100"
    android:versionName="1.0">

    <queries>
        <package android:name="org.lsposed.manager" />
        <package android:name="org.lsposed.lspatch" />
        <package android:name="com.tencent.tim" />
    </queries>

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="猫娘助手"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CatHelper">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="猫娘助手 · TIM 猫娘化模块（LSPosed）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="猫娘助手">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CustomStyleActivity"
            android:exported="false" />

        <activity
            android:name=".terminal.TerminalActivity"
            android:exported="false"
            android:label="内置终端" />

        <activity
            android:name=".ConsoleActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:label="猫娘助手"
            android:theme="@style/Theme.CatHelper" />

        <service
            android:name=".QQAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <provider
            android:name=".LogProvider"
            android:authorities="com.cathelperawa.owo.app.logs"
            android:exported="true" />

        <provider
            android:name=".core.ReportProvider"
            android:authorities="com.cathelperawa.owo.app.report"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
