<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_cookie"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_back_cookie"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_cookie_back"
            android:gravity="center"
            android:text="‹"
            android:textColor="#E7F0FF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cookie_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="网页登录"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cookie_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="● 还没登录"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_zoom_out"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="−"
            android:textColor="#C3D1E3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_zoom_in"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="+"
            android:textColor="#C3D1E3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_paste_cookie"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="粘贴 Cookie"
            android:textColor="#C3D1E3"
            android:textSize="12sp" />
    </LinearLayout>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="登录完成后会自动保存，不用手动点"
            android:textColor="#6F7D90"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_cookie_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#6F7D90"
            android:textSize="11sp" />
    </LinearLayout>

    
    <FrameLayout
        android:id="@+id/frame_cookie_web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <WebView
            android:id="@+id/wv_cookie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
    </FrameLayout>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_cookie_reload"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="刷新"
            android:textColor="#C3D1E3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_cookie_save"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.4"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:text="立即保存"
            android:textColor="#E7F0FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cookie_logout"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="退出登录"
            android:textColor="#C3D1E3"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
